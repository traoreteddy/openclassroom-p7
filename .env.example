# Copier ce fichier vers .env puis renseigner les valeurs.

# --- Clés d'API ---
# La collecte des événements passe par l'API Opendatasoft (jeu OpenAgenda),
# qui ne demande aucune clé. OPENAGENDA_API_KEY n'est utile que si l'on
# rebranche un jour l'API OpenAgenda native.
OPENAGENDA_API_KEY=
MISTRAL_API_KEY=votre_cle_mistral

# --- Périmètre de collecte ---
CITIES=["Paris"]          # liste JSON : ["Paris","Lyon","Marseille"]
PERIOD_DAYS=90            # fenêtre à venir, en jours
MAX_EVENTS=2000           # plafond d'événements collectés

# --- Vectorisation ---
# Fournisseur d'embeddings : "mistral" (API, défaut) ou "huggingface" (modèle local)
EMBEDDING_PROVIDER=mistral
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observabilité / traçabilité (optionnel, LangSmith) ---
# Active le tracing des chaînes LangChain : latences, chunks récupérés, coûts.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=puls-events-rag
