# Copier ce fichier vers .env puis renseigner les valeurs.

# --- Clés d'API ---
OPENAGENDA_API_KEY=votre_cle_open_agenda
MISTRAL_API_KEY=votre_cle_mistral

# --- Vectorisation ---
# Fournisseur d'embeddings : "mistral" (API, défaut) ou "huggingface" (modèle local)
EMBEDDING_PROVIDER=mistral
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observabilité / traçabilité (optionnel, LangSmith) ---
# Active le tracing des chaînes LangChain : latences, chunks récupérés, coûts.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=puls-events-rag
